# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically. Never add their real values here.

# Google OAuth client dedicated to Gmail readonly access.
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_PUBSUB_TOPIC=projects/replace-project/topics/gmail-receipts

# Generate all three application secrets independently, for example with
# `openssl rand -base64 48`. Each must contain at least 32 bytes.
GMAIL_OAUTH_STATE_SECRET=replace-me
GMAIL_DEDUPE_SECRET=replace-me
GMAIL_CRON_SECRET=replace-me

# Exact Pub/Sub push identity and destination configured in Google Cloud.
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://replace-project-ref.supabase.co/functions/v1/gmail-webhook
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=gmail-push@replace-project.iam.gserviceaccount.com
GOOGLE_PUBSUB_SUBSCRIPTION=projects/replace-project/subscriptions/gmail-receipts-push

# Optional comma-separated allowlist. This default matches AndroidManifest.xml.
GMAIL_OAUTH_ALLOWED_REDIRECT_URIS=com.qolve.fluyo://gmail-callback
