<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+): without this, the in-app voice entry (HU-05)
      can't see the system speech recognizer, so RecognizerIntent silently fails to
      resolve. Declaring the RECOGNIZE_SPEECH activity intent makes it launchable.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".FluyoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fluyo">
        <!--
          launchMode = singleTop (NOT singleTask): the app is single-Activity, so
          singleTop already delivers shared images to the running instance via
          onNewIntent (the OCR share flow). singleTask additionally re-parents/relaunches
          the task on return from a child activity, which corrupts the Activity Result
          API used by voice entry (HU-05), the photo picker and the camera — on real
          devices that killed the process while the recognizer was foreground, the
          RESULT_OK came back to a broken task and crashed. singleTop keeps the share
          flow and leaves Activity Results intact.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fluyo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Receive shared images from Yape / Plin / Galería / camera roll
              so users can OCR a receipt directly via the system Share sheet.
            -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!--
              Gmail OAuth callback: after the user consents in the browser, the
              gmail-connect Edge Function redirects back here with ?success=1.
              MainActivity receives it via onNewIntent and refreshes the profile
              to show the linked Gmail address.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.qolve.fluyo" android:host="gmail-callback" />
            </intent-filter>
        </activity>

        <!-- Shares exported CSV files from cacheDir via a content:// URI (HU-11). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Disable the default WorkManager initializer that runs via androidx.startup.
            We provide our own Configuration via FluyoApp : Configuration.Provider so
            HiltWorkerFactory can instantiate @HiltWorker workers.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
